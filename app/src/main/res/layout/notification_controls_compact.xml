<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/notification_status"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:text="알림 녹음 대기"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/action_primary"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:background="@drawable/notification_control_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp">
        <ImageView
            android:id="@+id/action_primary_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="녹음 시작 또는 정지"
            android:src="@drawable/ic_record_circle" />
        <TextView
            android:id="@+id/action_primary_label"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="시작"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_secondary"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:background="@drawable/notification_control_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="2dp">
        <ImageView
            android:id="@+id/action_secondary_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="녹음 취소 또는 녹음 초기화"
            android:src="@drawable/ic_record_stop" />
        <TextView
            android:id="@+id/action_secondary_label"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="중단"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>
